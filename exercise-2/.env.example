# Exercise 2: ERC-20 LoyaltyPoints Flask client
FLASK_SECRET=change-me-in-dev

# Deterministic dev mnemonic. Default is the Hardhat-node mnemonic, which is
# what `npx hardhat node` uses for its 20 pre-funded test accounts. The Flask
# UI derives the same accounts so account #0 matches the contract deployer.
#
# If you use Ganache CLI instead of `hardhat node`, swap to Ganache's default:
#   myth like bonus scare over problem client lizard pioneer submit female collect
GANACHE_MNEMONIC=test test test test test test test test test test test junk
