# ============================================================
# Exercise 1: VendingMachine on Sepolia
# Copy to .env and fill in the values you keep elsewhere.
# .env is gitignored. Do not commit secrets.
# ============================================================

# ---------- Hardhat: deployment to Sepolia ----------
# A node provider HTTPS endpoint. Get one for free from Alchemy or Infura.
#   https://www.alchemy.com/   ->  Apps -> Create app -> Sepolia
#   https://www.infura.io/     ->  API key -> Sepolia endpoints
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/REPLACE_WITH_YOUR_KEY

# 64-hex-char private key (no 0x prefix needed but accepted) of the wallet
# that will deploy the contract AND act as owner. Fund it with Sepolia faucet
# ETH first: https://cloud.google.com/application/web3/faucet
SEPOLIA_PRIVATE_KEY=REPLACE_WITH_64_HEX_CHARS

# Optional but recommended: lets `npx hardhat verify --network sepolia <addr>`
# upload the source so the contract is browseable on Etherscan.
# Get a free key at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=REPLACE_WITH_YOUR_ETHERSCAN_API_KEY


# ---------- Flask client ----------
FLASK_SECRET=change-me-in-dev

# Local-dev mode (chainId 1337 → hardhat node / Ganache):
# the client derives 10 deterministic accounts from this mnemonic.
# Default is the Hardhat-node mnemonic so account #0 matches the deployer.
# For Ganache CLI swap to: myth like bonus scare over problem client lizard pioneer submit female collect
GANACHE_MNEMONIC=test test test test test test test test test test test junk

# Sepolia mode (any chainId other than 1337):
# the client uses ONE account loaded from this private key.
# Reuse SEPOLIA_PRIVATE_KEY from above for convenience.
WALLET_PRIVATE_KEY=REPLACE_WITH_64_HEX_CHARS
